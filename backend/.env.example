# ==============================================================================
# PharmaMind AI - Environment Configuration
# ==============================================================================

# Project & Environment
PROJECT_NAME="PharmaMind AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="pharmamind-super-secret-production-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 18 primary, resilient SQLite fallback)
# Set to PostgreSQL connection string when service is running:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pharmamind"
DATABASE_FALLBACK_SQLITE=true
SQLITE_URL="sqlite+aiosqlite:///./pharmamind.db"

# Hardware & ML Resource Management (CPU execution on 16GB RAM)
ML_DEVICE="cpu"
TORCH_NUM_THREADS=4
ENABLE_LAZY_MODEL_LOADING=true
MAX_BATCH_SIZE=8
MEMORY_SAFETY_THRESHOLD_MB=1024

# External Biomedical APIs (to be populated in Phase 2)
PUBMED_API_KEY=""
OPENFDA_API_KEY=""
DAILYMED_BASE_URL="https://dailymed.nlm.nih.gov/dailymed/services/v2"
RXNORM_BASE_URL="https://rxnav.nlm.nih.gov/REST"

# Neo4j Graph DB (Optional; in-memory/JSON fallback provided)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
USE_LOCAL_GRAPH_FALLBACK=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

